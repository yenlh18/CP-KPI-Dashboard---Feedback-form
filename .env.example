# Neon Postgres connection string.
# In Vercel: Storage tab -> Create Database -> Neon -> Connect to Project.
# This auto-fills DATABASE_URL as a project env var; for local dev, copy it here.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# /admin is protected by Microsoft Entra ID (Office 365) SSO via Auth.js (NextAuth v5).
# AUTH_SECRET: any random string, used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# From your Entra ID App Registration (Overview page):
AUTH_MICROSOFT_ENTRA_ID_ID=""
# From App Registration -> Certificates & secrets -> a client secret VALUE (not the secret ID):
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0
# No trailing slash — must match the "issuer" field exactly as Microsoft's own
# discovery document reports it, or Auth.js rejects the token exchange.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Optional: only needed if you use the "Summarize with AI" button on /admin.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
